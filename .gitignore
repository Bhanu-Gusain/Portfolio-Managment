# ---------------------------------------------------------------
# Portfolio Dashboard — .gitignore
# Goal: NEVER commit personal data, credentials, or user artifacts.
# ---------------------------------------------------------------

# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Portfolio data folder (user holdings — strictly personal)
portfolio_data/**
!portfolio_data/templates/
!portfolio_data/templates/**
!portfolio_data/.gitkeep

# Legacy (pre-0.3.0) — kept so old local files aren't accidentally committed
data/analysis.db
data/analysis.db-journal
data/analysis.db-wal
data/analysis.db-shm
data/*.db
data/*.sqlite
data/*.sqlite3
data/uploads/
data/user_*.csv
data/user_*.xlsx
data/user_*.xls
data/my_*.csv
data/my_*.xlsx
data/my_*.xls
data/personal_*
uploads/

# Logs
*.log
logs/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Build artifacts
build/
dist/
*.whl
