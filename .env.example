# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored — never commit real values.
# All settings below have safe defaults; none are required.

# --- Database (local SQLite) ---
DB_PATH=data/analysis.db

# --- Local LLM (Ollama) — OPTIONAL ---
# If Ollama is not running, AI narratives are disabled but everything else works.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# --- Price cache freshness ---
CACHE_MAX_AGE_HOURS=12

# --- AMFI mutual fund NAV feed (public, no credentials needed) ---
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt

# --- Logging ---
LOG_LEVEL=INFO
