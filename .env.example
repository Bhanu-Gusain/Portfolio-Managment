# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored — never commit real values.
# All settings below have safe defaults; none are required.

# --- Input folder (where your portfolio CSV/XLSX files live) ---
PORTFOLIO_DATA_DIR=portfolio_data

# --- Price cache freshness (hours) ---
# Prices older than this trigger a refetch. Set to 0 to always refetch.
CACHE_MAX_AGE_HOURS=12

# --- AMFI mutual fund NAV feed (public, no credentials needed) ---
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt

# --- Mutual fund historical NAV API (public, no credentials needed) ---
MFAPI_BASE_URL=https://api.mfapi.in/mf

# --- Logging ---
LOG_LEVEL=INFO
